{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": {
      "@pinecone-database/pinecone": ["./dist"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "ts-compilation-test/src/**/*.ts",
    "ts-external-app-test/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
